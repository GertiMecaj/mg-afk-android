+        data class HungryPet(
+            val pet: PetSnapshot,
+            val maxHunger: Int,
+            val hungerPercent: Double,
+        )
+
+        // Re-rank every cycle. The hungriest selected pet always gets first priority,
+        // regardless of its slot/order in session.pets.
+        val target = session.pets
+            .asSequence()
+            .filter { it.id in config.petIds }
+            .mapNotNull { pet ->
+                val maxHunger = Constants.maxHungerFor(pet.species) ?: 1000
+                if (maxHunger <= 0) return@mapNotNull null
+                val hungerPercent = (pet.hunger / maxHunger.toDouble() * 100.0)
+                    .coerceIn(0.0, 100.0)
+                if (hungerPercent >= config.feedBelowPercent) return@mapNotNull null
+                HungryPet(pet, maxHunger, hungerPercent)
+            }
+            .minByOrNull { it.hungerPercent }
+            ?: return
+
+        // Never skip past the current lowest pet just because a command for it is still
+        // awaiting a server patch. Wait for that patch (or the short timeout) and rank
+        // again; this preserves strict lowest-hunger-first ordering.
+        if (target.pet.id in pendingPets) return
+
+        val pet = target.pet
+        val diet = MgApi.findPet(pet.species)?.diet.orEmpty()
+        if (diet.isEmpty()) return
+
+        val targetHunger = target.maxHunger * (config.feedBelowPercent / 100.0)
+        var hungerNeeded = (targetHunger - pet.hunger).coerceAtLeast(0.0)
+        if (hungerNeeded <= 0.0) return
+
+        // Hunger is tracked by the game in coin-value units. Build one bulk feed batch
+        // whose estimated crop value reaches the configured threshold. This prevents one
+        // very hungry pet from receiving a single crop every two seconds and starving the
+        // rest of the selected team behind it.
+        val compatibleFood = session.inventory.produce
+            .asSequence()
+            .filter { it.species in diet }
+            .map { food ->
+                val hungerValue = PriceCalculator.calculateCropSellPrice(
+                    food.species,
+                    food.scale,
+                    food.mutations,
+                )?.coerceAtLeast(1L) ?: 1L
+                food to hungerValue
+            }
+            .sortedWith(
+                compareBy<Pair<InventoryProduceItem, Long>>(
+                    { it.first.mutations.isNotEmpty() },
+                    { it.second },
+                    { it.first.scale },
+                )
+            )
+            .toList()
+
+        val foodIds = mutableListOf<String>()
+        if (compatibleFood.isNotEmpty()) {
+            for ((food, hungerValue) in compatibleFood) {
