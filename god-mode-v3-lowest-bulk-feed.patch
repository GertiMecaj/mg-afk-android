+                    { it.first.targetScale },
+                )
+            )
+            .toList()
+
+        for ((crop, hungerValue) in crops) {
+            harvestTargets += crop
+            harvestValueNeeded -= hungerValue.toDouble()
+            if (harvestValueNeeded <= 0.0) break
