+                hungerNeeded -= hungerValue.toDouble()
+                if (hungerNeeded <= 0.0) break
+            }
+
+            if (foodIds.isNotEmpty()) {
+                // One optimistic inventory update + one burst of FeedPet commands.
+                pendingPets[pet.id] = now + 2500L
+                feedPet(sessionId, pet.id, foodIds)
