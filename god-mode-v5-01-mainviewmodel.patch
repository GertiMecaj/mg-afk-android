+    // ---- GOD Hoarder ----
+
+    fun setGodHoarder(sessionId: String, enabled: Boolean, selections: Set<String>) {
+        val cleaned = selections.filter { it.isNotBlank() }.toSet()
+        if (!enabled || cleaned.isEmpty()) {
+            godHoarderConfigs.remove(sessionId)
+            godHoarderJobs.remove(sessionId)?.cancel()
+            return
+        }
+
+        godHoarderConfigs[sessionId] = GodHoarderConfig(cleaned)
+        if (godHoarderJobs[sessionId]?.isActive == true) return
+        godHoarderJobs[sessionId] = viewModelScope.launch {
+            while (true) {
+                val config = godHoarderConfigs[sessionId] ?: break
+                runGodHoarderStep(sessionId, config)
+                delay(1000)
+            }
+        }
+    }
+
+    private suspend fun runGodHoarderStep(sessionId: String, config: GodHoarderConfig) {
+        val session = _state.value.sessions.find { it.id == sessionId } ?: return
+        if (!session.connected) return
+
+        for (shop in session.shops) {
+            for (itemName in shop.itemNames.distinct()) {
+                val key = "${shop.type}\u001F$itemName"
+                val stock = shop.itemStocks[itemName] ?: 0
+                if (key in config.selections && stock > 0) {
+                    purchaseAllShopItem(sessionId, shop.type, itemName)
+                    delay(35)
+                }
+            }
+        }
+    }
