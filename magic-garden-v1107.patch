+    /**
+     * Harvest one mature grow slot.
+     *
+     * Since Magic Garden v1107 the web client mints [cropItemId] before sending the
+     * command. The server uses that id for the inventory item produced by the harvest;
+     * omitting it makes current servers reject/ignore HarvestCrop even though the socket
+     * remains connected. A default UUID keeps every existing caller compatible, including
+     * GOD mass harvest, Fast Money, Yuri and auto-feed harvests.
+     */
+    fun harvestCrop(
+        slot: Int,
+        slotsIndex: Int? = null,
+        cropItemId: String = UUID.randomUUID().toString(),
+    ) {
         val params = buildJsonObject {
             put("slot", JsonPrimitive(slot))
             if (slotsIndex != null) put("slotsIndex", JsonPrimitive(slotsIndex))
+            put("cropItemId", JsonPrimitive(cropItemId))
         }
         game("HarvestCrop", params)
     }
