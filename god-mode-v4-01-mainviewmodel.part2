+    // ---- GOD Fast Money ----
+
+    fun setGodFastMoney(sessionId: String, enabled: Boolean) {
+        if (!enabled) {
+            godFastMoneyConfigs.remove(sessionId)
+            godFastMoneyJobs.remove(sessionId)?.cancel()
+            godFastMoneyPendingPlants.remove(sessionId)
+            godFastMoneyTrackedTiles.remove(sessionId)
+            godFastMoneyPendingSiloRetrieveUntil.remove(sessionId)
+            return
+        }
+
+        if (godFastMoneyConfigs[sessionId] == null) {
+            val session = _state.value.sessions.find { it.id == sessionId } ?: return
+            godFastMoneyConfigs[sessionId] = GodFastMoneyConfig(
+                baselineSeedTotals = seedTotals(session),
+            )
+        }
+
+        if (godFastMoneyJobs[sessionId]?.isActive == true) return
+        godFastMoneyJobs[sessionId] = viewModelScope.launch {
+            while (true) {
+                val config = godFastMoneyConfigs[sessionId] ?: break
+                runGodFastMoneyStep(sessionId, config)
+                delay(1200)
+            }
+        }
+    }
+
+    private suspend fun runGodFastMoneyStep(sessionId: String, config: GodFastMoneyConfig) {
+        val client = clients[sessionId] ?: return
+        var session = _state.value.sessions.find { it.id == sessionId } ?: return
+        if (!session.connected) return
+        val now = System.currentTimeMillis()
+
+        val tracked = godFastMoneyTrackedTiles.getOrPut(sessionId) { mutableMapOf() }
+        val pendingPlant = godFastMoneyPendingPlants[sessionId]
+
+        // Confirm or expire the single outstanding plant command. Requiring BOTH the expected
+        // garden tile and a seed-count decrease prevents us from repeatedly spending the same
+        // pre-patch inventory stack.
+        if (pendingPlant != null) {
+            val currentTotal = seedTotals(session)[pendingPlant.species] ?: 0
+            val tileConfirmed = session.garden.any {
+                it.tileId == pendingPlant.tileId && it.species == pendingPlant.species
+            }
+            if (tileConfirmed && currentTotal < pendingPlant.beforeTotal) {
+                tracked[pendingPlant.tileId] = pendingPlant.species
+                godFastMoneyPendingPlants.remove(sessionId)
+            } else if (now >= pendingPlant.expiresAt) {
+                godFastMoneyPendingPlants.remove(sessionId)
+            }
+        }
+
+        // Stop owning a tile as soon as it disappears or is replaced with another species.
+        tracked.entries.removeAll { (tileId, species) ->
+            val onTile = session.garden.filter { it.tileId == tileId }
+            onTile.isEmpty() || onTile.none { it.species == species }
+        }
+
+        // First monetize any mature crops that Fast Money itself planted.
+        val trackedSnapshot = tracked.toMap()
+        val candidateKeys = session.garden
+            .filter { plant -> trackedSnapshot[plant.tileId] == plant.species }
+            .map { it.tileId to it.slotIndex }
+            .toSet()
+        if (candidateKeys.isNotEmpty()) {
+            harvestAndSellGodPlants(sessionId, candidateKeys) { plant ->
+                trackedSnapshot[plant.tileId] == plant.species
+            }
+            session = _state.value.sessions.find { it.id == sessionId } ?: return
+        }
+
+        // Buy every seed that is currently in stock. purchaseAllShopItem performs its own
+        // optimistic stock-to-zero update, so the next loop will not duplicate the order while
+        // the server shop patch is in flight.
+        val seedShop = session.shops.find { it.type == "seed" }
+        if (seedShop != null) {
+            seedShop.itemNames.distinct().forEach { species ->
+                val stock = seedShop.itemStocks[species] ?: 0
+                if (stock > 0 && MgApi.getPlants().containsKey(species)) {
+                    purchaseAllShopItem(sessionId, "seed", species)
+                }
+            }
+        }
+
+        session = _state.value.sessions.find { it.id == sessionId } ?: return
+        if (godFastMoneyPendingPlants[sessionId] != null) return
+
+        val totals = seedTotals(session)
+        val excessSpecies = totals.keys
+            .filter { species ->
+                val baseline = config.baselineSeedTotals[species] ?: 0
+                (totals[species] ?: 0) > baseline
+            }
+            .sortedBy { species -> MgApi.findItem(species)?.baseSellPrice ?: Double.MAX_VALUE }
+        if (excessSpecies.isEmpty()) return
+
+        // If an auto-stock setting moved the newly purchased stack into the silo, retrieve it.
+        val retrievalPending = godFastMoneyPendingSiloRetrieveUntil
+            .getOrPut(sessionId) { mutableMapOf() }
+        retrievalPending.entries.removeAll { it.value <= now }
+
+        val species = excessSpecies.firstOrNull { candidate ->
+            val inventoryQty = session.inventory.seeds.find { it.species == candidate }?.quantity ?: 0
+            inventoryQty > 0
+        } ?: run {
+            val siloSpecies = excessSpecies.firstOrNull { candidate ->
+                val siloQty = session.seedSilo.find { it.species == candidate }?.quantity ?: 0
+                siloQty > 0 && candidate !in retrievalPending
+            }
+            if (siloSpecies != null) {
+                retrievalPending[siloSpecies] = now + 5000L
+                moveSeedFromSilo(sessionId, siloSpecies)
             }
+            return
+        }
+
+        val occupied = occupiedPlantTiles(client) ?: return
+        val freeSlot = GardenTiles.firstFreeTile(occupied) ?: return
+        val beforeTotal = totals[species] ?: return
+        val baseline = config.baselineSeedTotals[species] ?: 0
+        if (beforeTotal <= baseline) return
+
+        godFastMoneyPendingPlants[sessionId] = GodPendingPlant(
+            species = species,
+            tileId = freeSlot,
+            beforeTotal = beforeTotal,
+            expiresAt = now + 8000L,
+        )
+        client.actions.plantSeed(slot = freeSlot, species = species)
+    }
+
+    // ---- GOD YuriPowerhouse ----
+
+    fun setGodYuriPowerhouse(
+        sessionId: String,
+        enabled: Boolean,
+        species: String,
+        blockRules: GodHarvestBlockRules,
+    ) {
+        if (!enabled || species.isBlank()) {
+            godYuriConfigs.remove(sessionId)
+            godYuriJobs.remove(sessionId)?.cancel()
+            return
+        }
+
+        godYuriConfigs[sessionId] = GodYuriConfig(species, blockRules)
+        if (godYuriJobs[sessionId]?.isActive == true) return
+        godYuriJobs[sessionId] = viewModelScope.launch {
+            while (true) {
+                val config = godYuriConfigs[sessionId] ?: break
+                runGodYuriStep(sessionId, config)
+                delay(1500)
+            }
+        }
+    }
+
+    private suspend fun runGodYuriStep(sessionId: String, config: GodYuriConfig) {
+        val session = _state.value.sessions.find { it.id == sessionId } ?: return
+        if (!session.connected) return
+        val now = System.currentTimeMillis()
+        val pending = purgeGodHarvestPending(sessionId, now)
+        val candidateKeys = session.garden
+            .asSequence()
+            .filter {
+                it.species == config.species &&
+                    it.endTime > 0L &&
+                    now >= it.endTime &&
+                    (it.tileId to it.slotIndex) !in pending &&
+                    !isGodHarvestBlocked(it, config.blockRules)
+            }
+            .map { it.tileId to it.slotIndex }
+            .toSet()
+        if (candidateKeys.isEmpty()) return
+
+        harvestAndSellGodPlants(sessionId, candidateKeys) { plant ->
+            plant.species == config.species && !isGodHarvestBlocked(plant, config.blockRules)
         }
     }
 
