+package com.mgafk.app.ui.god
+
+import com.mgafk.app.data.model.GardenPlantSnapshot
+import com.mgafk.app.data.repository.MgApi
+
+enum class GodFilterMatchMode { ANY, ALL }
+
+data class GodHarvestBlockRules(
+    val blockSizeRange: Boolean = false,
+    val minSizePercent: Double = 95.0,
+    val maxSizePercent: Double = 100.0,
+    val blockGoldOrRainbow: Boolean = false,
+    val blockWeatherAffected: Boolean = false,
+    val matchMode: GodFilterMatchMode = GodFilterMatchMode.ANY,
+)
+
+/**
+ * Uses the same visual-size mapping as GardenCard. A just-mature crop (scale 1.0)
+ * is 50% when the species can continue growing above 1.0, and maxScale maps to 100%.
+ */
+fun godCropSizePercent(plant: GardenPlantSnapshot): Double {
+    val maxScale = MgApi.getPlants()[plant.species]?.maxScale ?: 1.0
+    val targetScale = plant.targetScale
+    val percent = if (maxScale <= 1.0) {
+        if (targetScale >= 1.0) 100.0 else targetScale * 100.0
+    } else if (targetScale <= 1.0) {
+        targetScale * 50.0
+    } else {
+        50.0 + (targetScale - 1.0) / (maxScale - 1.0) * 50.0
+    }
+    return percent.coerceIn(0.0, 100.0)
+}
+
+private val WEATHER_MUTATIONS = setOf(
+    "wet", "chilled", "frozen", "thunderstruck",
+    "ambershine", "ambercharged", "amberlit", "amberbound",
+    "dawnlit", "dawncharged", "dawnbound",
+)
+
+fun isGodWeatherAffected(plant: GardenPlantSnapshot): Boolean =
+    plant.mutations.any { it.lowercase() in WEATHER_MUTATIONS }
+
+fun isGodHarvestBlocked(
+    plant: GardenPlantSnapshot,
+    rules: GodHarvestBlockRules,
+): Boolean {
+    val matches = buildList {
+        if (rules.blockSizeRange) {
+            val low = minOf(rules.minSizePercent, rules.maxSizePercent)
+            val high = maxOf(rules.minSizePercent, rules.maxSizePercent)
+            add(godCropSizePercent(plant) in low..high)
+        }
+        if (rules.blockGoldOrRainbow) {
+            add(plant.mutations.any { it.equals("Gold", true) || it.equals("Rainbow", true) })
+        }
+        if (rules.blockWeatherAffected) {
+            add(isGodWeatherAffected(plant))
+        }
+    }
+
+    if (matches.isEmpty()) return false
+    return when (rules.matchMode) {
+        GodFilterMatchMode.ANY -> matches.any { it }
+        GodFilterMatchMode.ALL -> matches.all { it }
+    }
+}
