+    /**
+     * GOD mode batch harvest. The UI submits the selected tile/slot pairs in one tap;
+     * this method validates them against the latest garden snapshot and sends the
+     * HarvestCrop commands in a short sequence so the socket is not flooded at once.
+     */
+    fun harvestCrops(sessionId: String, targets: List<Pair<Int, Int>>) {
+        val actions = clients[sessionId]?.actions ?: return
+        val session = _state.value.sessions.find { it.id == sessionId } ?: return
+        val now = System.currentTimeMillis()
+
+        val livePlants = session.garden.associateBy { it.tileId to it.slotIndex }
+        val validTargets = targets
+            .distinct()
+            .filter { key ->
+                val plant = livePlants[key] ?: return@filter false
+                plant.endTime > 0L && now >= plant.endTime
+            }
+
+        if (validTargets.isEmpty()) return
+
+        viewModelScope.launch {
+            validTargets.forEachIndexed { index, (tileId, slotIndex) ->
+                actions.harvestCrop(slot = tileId, slotsIndex = slotIndex)
+                // Keep commands ordered while avoiding a single large WebSocket burst.
+                if (index < validTargets.lastIndex) delay(50)
+            }
+        }
+    }
+
