+
+private data class PlantGroup(
+    val species: String,
+    val displayName: String,
+    val plants: List<GardenPlantSnapshot>,
+)
+
+/** Recompose once per second so crops become selectable as soon as they mature. */
+@Composable
+private fun rememberGodClock(): Long {
+    var now by remember { mutableLongStateOf(System.currentTimeMillis()) }
+    LaunchedEffect(Unit) {
+        while (true) {
+            delay(1000)
+            now = System.currentTimeMillis()
+        }
+    }
+    return now
+}
+
+private fun GardenPlantSnapshot.isReady(now: Long): Boolean =
+    endTime > 0L && now >= endTime
+
+private fun formatRemaining(endTime: Long, now: Long): String {
+    val remaining = (endTime - now).coerceAtLeast(0L) / 1000L
+    if (remaining <= 0L) return "Ready"
+    val hours = remaining / 3600L
+    val minutes = (remaining % 3600L) / 60L
+    val seconds = remaining % 60L
+    return when {
+        hours > 0L -> "${hours}h ${minutes}m"
+        minutes > 0L -> "${minutes}m ${seconds}s"
+        else -> "${seconds}s"
+    }
+}
+
+/**
+ * GOD mode: choose planted crop species, then harvest every mature crop belonging
+ * to the selected species with one button press.
+ *
+ * Selection is intentionally species-based rather than tile-based: selecting Carrot,
+ * for example, targets every mature planted Carrot across the garden, including
+ * individual grow slots on multi-slot plants.
+ */
+@Composable
+fun GodCard(
+    plants: List<GardenPlantSnapshot>,
+    apiReady: Boolean = false,
+    onCollect: (List<Pair<Int, Int>>) -> Unit = {},
+) {
+    val now = rememberGodClock()
+
+    var selectedSpecies by rememberSaveable(
+        stateSaver = listSaver<Set<String>, String>(
+            save = { it.toList() },
+            restore = { it.toSet() },
+        ),
+    ) { mutableStateOf(emptySet()) }
+
+    val groups = remember(plants, apiReady) {
+        plants
+            .filter { it.species.isNotBlank() }
+            .groupBy { it.species }
+            .map { (species, groupedPlants) ->
+                val displayName = MgApi.findItem(species)?.name
+                    ?.removeSuffix(" Seed")
+                    ?.takeIf { it.isNotBlank() }
+                    ?: species
+                PlantGroup(
+                    species = species,
+                    displayName = displayName,
+                    plants = groupedPlants.sortedWith(compareBy({ it.tileId }, { it.slotIndex })),
+                )
+            }
+            .sortedBy { it.displayName.lowercase() }
+    }
+
+    // Remove selections for crops that are no longer planted.
+    val availableSpecies = remember(groups) { groups.map { it.species }.toSet() }
+    LaunchedEffect(availableSpecies) {
+        selectedSpecies = selectedSpecies.intersect(availableSpecies)
+    }
+
+    val readySpecies = remember(groups, now) {
+        groups.filter { group -> group.plants.any { it.isReady(now) } }
+            .map { it.species }
+            .toSet()
+    }
+
+    val selectedTargets = remember(plants, selectedSpecies, now) {
+        plants
+            .asSequence()
+            .filter { it.species in selectedSpecies && it.isReady(now) }
+            .map { it.tileId to it.slotIndex }
+            .distinct()
+            .toList()
+    }
+
+    val totalReady = remember(plants, now) { plants.count { it.isReady(now) } }
+
+    AppCard(
+        title = "GOD — Mass Harvest",
+        persistKey = "god_mass_harvest",
+        collapsible = true,
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .background(Accent.copy(alpha = 0.08f), RoundedCornerShape(12.dp))
+                .padding(12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            Icon(
+                imageVector = Icons.Outlined.Bolt,
+                contentDescription = null,
+                tint = Accent,
+                modifier = Modifier.size(22.dp),
+            )
+            Column(modifier = Modifier.weight(1f)) {
+                Text(
+                    text = "Select crops, then collect them all at once.",
+                    color = TextPrimary,
+                    fontSize = 13.sp,
+                    fontWeight = FontWeight.SemiBold,
+                )
+                Text(
+                    text = "$totalReady ready • ${plants.size} planted",
+                    color = TextSecondary,
+                    fontSize = 11.sp,
+                )
+            }
+        }
+
+        Spacer(modifier = Modifier.height(12.dp))
+
+        if (plants.isEmpty()) {
+            Text(
+                text = "Nothing is currently planted in this garden.",
+                color = TextMuted,
+                fontSize = 12.sp,
+            )
+            return@AppCard
+        }
+
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            OutlinedButton(
+                modifier = Modifier.weight(1f),
+                enabled = readySpecies.isNotEmpty(),
+                onClick = { selectedSpecies = readySpecies },
+            ) {
+                Text("Select all ready", fontSize = 11.sp)
+            }
+            OutlinedButton(
+                modifier = Modifier.weight(1f),
+                enabled = selectedSpecies.isNotEmpty(),
+                onClick = { selectedSpecies = emptySet() },
+            ) {
+                Text("Clear", fontSize = 11.sp)
+            }
+        }
+
+        Spacer(modifier = Modifier.height(10.dp))
+
+        Column(verticalArrangement = Arrangement.spacedBy(7.dp)) {
+            groups.forEach { group ->
+                val readyCount = group.plants.count { it.isReady(now) }
+                val isSelected = group.species in selectedSpecies
+                val enabled = readyCount > 0
+                val firstNotReady = group.plants
+                    .filterNot { it.isReady(now) }
+                    .minByOrNull { it.endTime }
+
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .background(
+                            if (isSelected) Accent.copy(alpha = 0.10f) else SurfaceDark,
+                            RoundedCornerShape(10.dp),
+                        )
+                        .then(
+                            if (enabled) {
+                                Modifier.clickable {
+                                    selectedSpecies = if (isSelected) {
+                                        selectedSpecies - group.species
+                                    } else {
+                                        selectedSpecies + group.species
+                                    }
+                                }
+                            } else Modifier
+                        )
+                        .padding(horizontal = 10.dp, vertical = 8.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Checkbox(
+                        checked = isSelected,
+                        enabled = enabled,
+                        onCheckedChange = { checked ->
+                            selectedSpecies = if (checked) {
+                                selectedSpecies + group.species
+                            } else {
+                                selectedSpecies - group.species
+                            }
+                        },
+                    )
+
+                    SpriteImage(
+                        category = "plants",
+                        name = group.species,
+                        size = 36.dp,
+                        contentDescription = group.displayName,
+                    )
+
+                    Column(
+                        modifier = Modifier
+                            .weight(1f)
+                            .padding(start = 10.dp),
+                    ) {
+                        Text(
+                            text = group.displayName,
+                            color = if (enabled) TextPrimary else TextMuted,
+                            fontSize = 13.sp,
+                            fontWeight = FontWeight.SemiBold,
+                        )
+                        Text(
+                            text = when {
+                                readyCount == group.plants.size -> "$readyCount ready"
+                                readyCount > 0 -> "$readyCount ready / ${group.plants.size} planted"
+                                firstNotReady != null -> "Ready in ${formatRemaining(firstNotReady.endTime, now)}"
+                                else -> "Not ready"
+                            },
+                            color = if (readyCount > 0) StatusConnected else TextMuted,
+                            fontSize = 11.sp,
+                        )
+                    }
+                }
+            }
+        }
+
+        Spacer(modifier = Modifier.height(14.dp))
+
+        Button(
+            modifier = Modifier.fillMaxWidth(),
+            enabled = selectedTargets.isNotEmpty(),
+            onClick = {
+                val targets = selectedTargets
+                if (targets.isNotEmpty()) {
+                    onCollect(targets)
+                    // Clear immediately so repeated taps cannot accidentally resend the same batch
+                    // while waiting for the server's garden patches to arrive.
+                    selectedSpecies = emptySet()
+                }
+            },
+        ) {
+            Icon(
+                imageVector = Icons.Outlined.Bolt,
+                contentDescription = null,
+                modifier = Modifier.size(18.dp),
+            )
+            Spacer(modifier = Modifier.size(6.dp))
+            Text(
+                text = if (selectedTargets.isEmpty()) {
+                    "COLLECT SELECTED"
+                } else {
+                    "COLLECT ${selectedTargets.size} SELECTED"
+                },
+                fontWeight = FontWeight.Bold,
+            )
+        }
+
+        if (selectedSpecies.isNotEmpty() && selectedTargets.isEmpty()) {
+            Spacer(modifier = Modifier.height(8.dp))
+            Text(
+                text = "Selected crops are not mature yet.",
+                color = TextMuted,
+                fontSize = 11.sp,
+            )
+        }
+    }
+}
