+@Composable
+private fun GodFastMoneyCard(
+    seeds: List<InventorySeedItem>,
+    seedSilo: List<InventorySeedItem>,
+    shops: List<ShopSnapshot>,
+    freePlantTiles: Int,
+    onFastMoneyChanged: (Boolean) -> Unit,
+) {
+    var enabled by rememberSaveable { mutableStateOf(false) }
+    val seedShop = remember(shops) { shops.find { it.type == "seed" } }
+    val availableStock = remember(seedShop) {
+        seedShop?.itemStocks?.values?.sumOf { it.coerceAtLeast(0) } ?: 0
+    }
+    val ownedSeeds = remember(seeds, seedSilo) {
+        seeds.sumOf { it.quantity } + seedSilo.sumOf { it.quantity }
+    }
+
+    LaunchedEffect(enabled) {
+        onFastMoneyChanged(enabled)
+    }
+
+    AppCard(
+        title = "GOD — Fast Money",
+        persistKey = "god_fast_money",
+        collapsible = true,
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .background(Accent.copy(alpha = 0.08f), RoundedCornerShape(12.dp))
+                .padding(12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            Icon(
+                imageVector = Icons.Outlined.ShoppingCart,
+                contentDescription = null,
+                tint = Accent,
+                modifier = Modifier.size(22.dp),
+            )
+            Column(modifier = Modifier.weight(1f)) {
+                Text(
+                    "Buy → plant → harvest → sell",
+                    fontSize = 13.sp,
+                    fontWeight = FontWeight.SemiBold,
+                    color = TextPrimary,
+                )
+                Text(
+                    "$availableStock seed stock • $ownedSeeds seeds owned • $freePlantTiles free tiles",
+                    fontSize = 10.sp,
+                    color = TextSecondary,
+                )
+            }
+            Switch(
+                checked = enabled,
+                onCheckedChange = { enabled = it },
+            )
+        }
+
+        Spacer(modifier = Modifier.height(10.dp))
+        Text(
+            "While enabled, GOD buys every seed currently available in the Seeds shop, plants purchased excess seeds into free dirt tiles, harvests those Fast Money plots as soon as they mature, and sells only the produce created by this loop.",
+            fontSize = 10.sp,
+            color = TextMuted,
+        )
+        Spacer(modifier = Modifier.height(6.dp))
+        Text(
+            "Seeds that already existed when Fast Money was enabled are reserved and are not intentionally consumed by this automation.",
+            fontSize = 9.sp,
+            color = TextMuted,
+        )
+
+        if (enabled) {
+            Spacer(modifier = Modifier.height(10.dp))
+            Text(
+                "FAST MONEY RUNNING",
+                fontSize = 10.sp,
+                fontWeight = FontWeight.Bold,
+                color = StatusConnected,
+            )
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class, ExperimentalLayoutApi::class)
+@Composable
+private fun GodYuriPowerhouseCard(
+    plants: List<GardenPlantSnapshot>,
+    apiReady: Boolean,
+    onYuriPowerhouseChanged: (enabled: Boolean, species: String, rules: GodHarvestBlockRules) -> Unit,
+) {
+    var enabled by rememberSaveable { mutableStateOf(false) }
+    var selectedSpecies by rememberSaveable { mutableStateOf<String?>(null) }
+
+    var blockSizeRange by rememberSaveable { mutableStateOf(false) }
+    var sizeMin by rememberSaveable { mutableFloatStateOf(95f) }
+    var sizeMax by rememberSaveable { mutableFloatStateOf(100f) }
+    var blockGoldOrRainbow by rememberSaveable { mutableStateOf(false) }
+    var blockWeather by rememberSaveable { mutableStateOf(false) }
+    var matchModeName by rememberSaveable { mutableStateOf(GodFilterMatchMode.ANY.name) }
+    val matchMode = GodFilterMatchMode.valueOf(matchModeName)
+
+    val blockRules = GodHarvestBlockRules(
+        blockSizeRange = blockSizeRange,
+        minSizePercent = sizeMin.toDouble(),
+        maxSizePercent = sizeMax.toDouble(),
+        blockGoldOrRainbow = blockGoldOrRainbow,
+        blockWeatherAffected = blockWeather,
+        matchMode = matchMode,
+    )
+
+    val speciesOptions = remember(plants, selectedSpecies, apiReady) {
+        (plants.map { it.species } + listOfNotNull(selectedSpecies))
+            .filter { it.isNotBlank() }
+            .distinct()
+            .sortedBy { species ->
+                (MgApi.findItem(species)?.name?.removeSuffix(" Seed") ?: species).lowercase()
+            }
+    }
+
+    val now = rememberGodClock()
+    val selectedPlants = remember(plants, selectedSpecies) {
+        plants.filter { it.species == selectedSpecies }
+    }
+    val readySelected = remember(selectedPlants, now) {
+        selectedPlants.count { it.isReady(now) }
+    }
+    val blockedReady = remember(selectedPlants, now, blockRules) {
+        selectedPlants.count { it.isReady(now) && isGodHarvestBlocked(it, blockRules) }
+    }
+    val enabledFilterCount = listOf(blockSizeRange, blockGoldOrRainbow, blockWeather).count { it }
+
+    LaunchedEffect(enabled, selectedSpecies, blockRules) {
+        onYuriPowerhouseChanged(
+            enabled && !selectedSpecies.isNullOrBlank(),
+            selectedSpecies.orEmpty(),
+            blockRules,
+        )
+    }
+
+    AppCard(
+        title = "GOD — YuriPowerhouse",
+        persistKey = "god_yuri_powerhouse",
+        collapsible = true,
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .background(Accent.copy(alpha = 0.08f), RoundedCornerShape(12.dp))
+                .padding(12.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
